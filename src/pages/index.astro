---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Principles from '../components/Principles.astro';
import Origin from '../components/Origin.astro';
import Mascot from '../components/Mascot.astro';
import People from '../components/People.astro';
import zhCN from '../i18n/locales/zh-CN';
---

<Layout title={zhCN.meta.title} description={zhCN.meta.description} snapDots={true}>
  <main class="snap-root">
    <Hero />
    <Features />
    <Principles />
    <Origin />
    <Mascot />
    <People />
  </main>
</Layout>
