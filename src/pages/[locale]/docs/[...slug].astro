---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { getDocEntry, pagerFor, allDocSlugs } from '../../../lib/docs';
import type { DocsLocale } from '../../../data/docs-nav';

export function getStaticPaths() {
  const locales = [
    { param: 'en', locale: 'en' as DocsLocale },
    { param: 'zh-tw', locale: 'zh-TW' as DocsLocale },
    { param: 'ja', locale: 'ja' as DocsLocale },
  ];
  return locales.flatMap(({ param, locale }) =>
    allDocSlugs().map((slug) => ({
      params: { locale: param, slug },
      props: { locale, slug },
    })),
  );
}

const { locale, slug } = Astro.props as { locale: DocsLocale; slug: string };
const entry = await getDocEntry(locale, slug);
if (!entry) {
  return Astro.redirect(locale === 'zh-CN' ? '/docs/' : `/${Astro.params.locale}/docs/`);
}
const { Content, headings } = await entry.render();
const { prev, next } = pagerFor(locale, slug);
---

<DocsLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  slug={slug}
  headings={headings}
  prev={prev}
  next={next}
>
  <Content />
</DocsLayout>
