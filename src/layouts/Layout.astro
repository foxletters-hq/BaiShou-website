---
/**
 * BaiShou 产品官网布局
 */
import "../styles/global.css";
import Header from "../components/Header.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CommunityModal from "../components/CommunityModal.astro";
import DownloadPopup from "../components/DownloadPopup.astro";
import ThemeScene from "../components/ThemeScene.astro";
import UmamiAnalytics from "../components/UmamiAnalytics.astro";
import SeoHead, { type AlternateLink } from "../components/SeoHead.astro";
import { ViewTransitions } from "astro:transitions";
import zhCN from "../i18n/locales/zh-CN";
import { messages, type Locale } from "../i18n";
import { getInitialLocaleScript } from "../scripts/i18n";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  locale?: Locale;
  alternates?: AlternateLink[];
  /** 是否显示侧边 snap 导航点（仅首页需要） */
  snapDots?: boolean;
  /** 文档等页面：关掉极光/雨滴与叠层，纯色底 */
  plainBg?: boolean;
}

const {
  title = zhCN.meta.title,
  description = zhCN.meta.description,
  canonical = Astro.url.href,
  ogImage = "/assets/images/app-icon.png",
  locale = "zh-CN",
  alternates = [],
  snapDots = false,
  plainBg = false,
} = Astro.props;

const canonicalUrl = new URL(canonical, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImageUrl={ogImageUrl}
      locale={locale}
      alternates={alternates}
    />
    <slot name="head" />

    <script is:inline set:html={getInitialLocaleScript()} />
    <style is:inline id="i18n-anti-fout">
      html[data-locale]:not([data-locale="zh-CN"]):not([data-i18n-ready]) body {
        visibility: hidden !important;
      }
    </style>
    <noscript>
      <style is:inline>
        html[data-locale]:not([data-locale="zh-CN"]):not([data-i18n-ready]) body {
          visibility: visible !important;
        }
      </style>
    </noscript>
    <script is:inline>
      (function () {
        const key = "baishou-theme";
        const stored = localStorage.getItem(key);
        const theme =
    stored === "light" || stored === "dark"
      ? stored
      : window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
    />
    <UmamiAnalytics />
    {plainBg && <ViewTransitions />}
  </head>
  <body class:list={[{ "plain-bg": plainBg }]}>
    {!plainBg && <ThemeScene />}
    {!plainBg && <div class="bg-overlay" aria-hidden="true" />}
    <Header snapDots={snapDots} />
    <slot />
    <SiteFooter />
    <CommunityModal />
    <DownloadPopup />
    <script is:inline define:vars={{ messages }}>
      (function () {
        try {
          const locale =
      document.documentElement.dataset.locale ||
      document.documentElement.lang ||
      'zh-CN';
          if (locale && locale !== 'zh-CN' && messages && messages[locale]) {
            const dict = messages[locale];
            const t = function (d, p) {
        return (
          p.split('.').reduce(function (acc, k) {
            return acc && typeof acc === 'object' && k in acc ? acc[k] : undefined;
          }, d) || p
        );
      };

            document.querySelectorAll('[data-i18n]').forEach(function (el) {
              const key = el.getAttribute('data-i18n');
              if (key) el.textContent = t(dict, key);
            });
            document.querySelectorAll('[data-i18n-html]').forEach(function (el) {
              const key = el.getAttribute('data-i18n-html');
              if (key) el.innerHTML = t(dict, key);
            });
            document.querySelectorAll('[data-i18n-aria-label]').forEach(function (el) {
              const key = el.getAttribute('data-i18n-aria-label');
              if (key) el.setAttribute('aria-label', t(dict, key));
            });
            document.querySelectorAll('[data-i18n-alt]').forEach(function (el) {
              const key = el.getAttribute('data-i18n-alt');
              if (key) el.alt = t(dict, key);
            });
            document.querySelectorAll('[data-i18n-prefix]').forEach(function (el) {
              const key = el.getAttribute('data-i18n-prefix');
              const name = el.getAttribute('data-i18n-name');
              if (key && name) el.alt = name + t(dict, key);
            });
            document.querySelectorAll('[data-i18n-badge]').forEach(function (el) {
              const key = el.getAttribute('data-i18n-badge');
              if (key) {
                const val = t(dict, key);
                el.textContent = val;
                el.hidden = !val;
              }
            });
            document.querySelectorAll('[data-docs-link]').forEach(function (el) {
              const hrefMap = {
          'zh-CN': '/docs/',
          'zh-TW': '/zh-tw/docs/',
          en: '/en/docs/',
          ja: '/ja/docs/',
        };
              el.href = hrefMap[locale] || '/docs/';
            });
            if (dict.meta && dict.meta.title) {
              const docsRoot = document.querySelector('[data-docs-root]');
              if (!docsRoot) {
                document.title = dict.meta.title;
              }
            }
          }
        } catch (e) {
          console.error('Fast i18n sync error:', e);
        } finally {
          document.documentElement.dataset.i18nReady = 'true';
        }
      })();
    </script>

    <script>
      import { initLayoutClient } from "../scripts/layoutInit";
      initLayoutClient();
    </script>
  </body>
</html>
