---
export interface TopicItem {
  title: string;
  href: string;
  description: string;
}

interface Props {
  items: TopicItem[];
  navLabel?: string;
}

const { items, navLabel = 'Topics' } = Astro.props;
---

<nav class="bs-topics" aria-label={navLabel}>
  {
    items.map((item) => (
      <a class="bs-topic card" href={item.href}>
        <span class="bs-topic__title">{item.title}</span>
        <span class="bs-topic__desc">{item.description}</span>
      </a>
    ))
  }
</nav>

<style is:global>
  .bs-topics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 28px 0 0;
  }

  .bs-topic.card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 18px 16px;
    text-decoration: none;
    color: inherit;
    background: var(--surface-bg) !important;
    border: 1px solid var(--accent-border) !important;
    border-radius: var(--radius-lg) !important;
    box-shadow: none !important;
    backdrop-filter: blur(8px);
    transition:
      background var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  .bs-topic.card:hover,
  .bs-topic.card:focus-visible {
    background: var(--surface-bg-hover) !important;
    border-color: var(--accent-border-hover) !important;
    transform: none;
  }

  .bs-topic.card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .bs-topic__title {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-heading);
  }

  .bs-topic__desc {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .bs-topics {
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: 16px;
    }

    .bs-topic.card {
      padding: 14px 16px;
    }
  }
</style>
