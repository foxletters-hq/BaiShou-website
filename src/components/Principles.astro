---
import { PRINCIPLE_IDS } from '../data/site';
import { t } from '../i18n';
import zhCN from '../i18n/locales/zh-CN';
import { HardDrive, Unlock, Network, Cloud } from 'lucide-react';

const principleIcons = {
  local: HardDrive,
  open: Unlock,
  ai: Network,
  official: Cloud,
} as const;
---

<section id="principles" class="snap-page">
  <div class="container snap-page-inner">
    <div class="reveal section-heading">
      <p class="section-eyebrow" data-i18n="principles.eyebrow">Principles</p>
      <h2 data-i18n="principles.title">{zhCN.principles.title}</h2>
      <p class="section-lead" data-i18n="principles.lead">
        {zhCN.principles.lead}
      </p>
    </div>

    <div class="principles-grid reveal">
      {PRINCIPLE_IDS.map((id) => {
        const Icon = principleIcons[id];
        const badge = zhCN.principles.items[id].badge;
        return (
          <article class="card principle-card">
            <div class="principle-card-head">
              <div class="feature-icon principle-icon" aria-hidden="true">
                <Icon size={20} strokeWidth={1.75} />
              </div>
              <h3 data-i18n={`principles.items.${id}.title`}>
                {t(zhCN, `principles.items.${id}.title`)}
              </h3>
              {badge && (
                <span class="feature-badge" data-i18n-badge={`principles.items.${id}.badge`}>
                  {badge}
                </span>
              )}
            </div>
            <p data-i18n={`principles.items.${id}.desc`}>
              {t(zhCN, `principles.items.${id}.desc`)}
            </p>
          </article>
        );
      })}
    </div>
  </div>
</section>
