---
import { LOCALE_OPTIONS, type Locale } from '../i18n';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
let currentLocale: Locale = 'zh-CN';
if (/^\/en(\/|$)/.test(path)) currentLocale = 'en';
else if (/^\/ja(\/|$)/.test(path)) currentLocale = 'ja';
else if (/^\/zh-tw(\/|$)/.test(path)) currentLocale = 'zh-TW';

const currentOption =
  LOCALE_OPTIONS.find((option) => option.code === currentLocale) ?? LOCALE_OPTIONS[0];
const currentShort = currentOption.shortLabel;
---

<div class="lang-switcher" data-lang-switcher>
  <button
    type="button"
    class="lang-trigger"
    data-lang-trigger
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label="选择语言"
    data-i18n-aria-label="a11y.langSelect"
  >
    <span class="lang-trigger-text" data-lang-current>{currentShort}</span>
  </button>
  <ul class="lang-menu" role="listbox" hidden>
    {LOCALE_OPTIONS.map((option) => (
      <li role="presentation">
        <button
          type="button"
          class:list={['lang-option', { 'is-active': option.code === currentLocale }]}
          role="option"
          data-lang-option={option.code}
          aria-label={option.label}
          aria-selected={option.code === currentLocale ? 'true' : 'false'}
        >
          {option.shortLabel}
        </button>
      </li>
    ))}
  </ul>
</div>

<script is:inline>
  (function () {
    try {
      const k = 'baishou-locale';
      const path = window.location.pathname;
      const isDocsPath = /^\/(en|ja|zh-tw)\/docs/.test(path);
      const lang = isDocsPath
      ? (document.documentElement.lang || 'zh-CN')
      : (localStorage.getItem(k) || document.documentElement.lang || 'zh-CN');
      const map = { 'zh-CN': '简中', 'zh-TW': '繁中', en: 'EN', ja: '日文' };
      if (map[lang]) {
        const root = document.querySelector('[data-lang-switcher]');
        if (root) {
          const label = root.querySelector('[data-lang-current]');
          if (label && label.textContent !== map[lang]) {
            label.textContent = map[lang];
          }
          const prev = root.querySelector('.lang-option.is-active');
          if (prev && prev.getAttribute('data-lang-option') !== lang) {
            prev.classList.remove('is-active');
            prev.setAttribute('aria-selected', 'false');
          }
          const curr = root.querySelector('[data-lang-option="' + lang + '"]');
          if (curr) {
            curr.classList.add('is-active');
            curr.setAttribute('aria-selected', 'true');
          }
        }
      }
    } catch {
      // localStorage 不可用时保持默认语言显示
    }
  })();
</script>
