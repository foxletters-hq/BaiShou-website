---
/** 主题背景：浅色「初雪静湖」壁纸 / 深色「背景模糊 + WebGL雨滴」效果 */
---

<div class="theme-scene" data-theme-scene aria-hidden="true">
  <div
    class="theme-wallpaper theme-wallpaper--light"
    style="background-image: url('/assets/images/bg/day-snowlake.jpg')"
  >
  </div>
  <div class="theme-dark-layer">
    <div
      class="theme-wallpaper theme-wallpaper--dark-fallback"
      style="background-image: url('/assets/images/dark-city-bg.jpg')"
    >
    </div>
    <canvas class="theme-canvas theme-canvas--rain" data-rain-canvas></canvas>
  </div>
</div>

<script>
  import { initBaishouRaindrop, type BaishouRaindropController } from '../scripts/baishouRaindrop';
  import { initRainEffect, type RainEffectController } from '../scripts/rainEffect';

  let raindrop: BaishouRaindropController | null = null;
  let rainFallback: RainEffectController | null = null;
  let stopTimer: number | null = null;
  let themeSceneBound = false;

  const isDarkTheme = () => document.documentElement.dataset.theme === 'dark';

  const prefersReducedMotion = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const getScene = () => document.querySelector<HTMLElement>('[data-theme-scene]');
  const getRainCanvas = () => document.querySelector<HTMLCanvasElement>('[data-rain-canvas]');

  const clearStopTimer = () => {
    if (stopTimer !== null) {
      window.clearTimeout(stopTimer);
      stopTimer = null;
    }
  };

  const stopRainNow = () => {
    clearStopTimer();
    raindrop?.stop();
    rainFallback?.stop();
  };

  const ensureControllers = (rainCanvas: HTMLCanvasElement) => {
    if (!raindrop) {
      raindrop = initBaishouRaindrop(rainCanvas);
    }
    if (!raindrop && !rainFallback) {
      rainFallback = initRainEffect(rainCanvas);
      rainCanvas.classList.add('is-ready');
    }
  };

  const syncScene = () => {
    const scene = getScene();
    const rainCanvas = getRainCanvas();
    if (!scene || !rainCanvas) return;

    if (prefersReducedMotion()) {
      stopRainNow();
      scene.setAttribute('aria-hidden', 'true');
      return;
    }

    ensureControllers(rainCanvas);

    if (!isDarkTheme()) {
      scene.setAttribute('aria-hidden', 'true');
      raindrop?.warmup();
      clearStopTimer();
      stopTimer = window.setTimeout(() => {
        if (!isDarkTheme()) {
          stopRainNow();
        }
      }, 560);
      return;
    }

    clearStopTimer();
    scene.setAttribute('aria-hidden', 'false');

    if (raindrop) {
      rainFallback?.stop();
      raindrop.start();
      return;
    }

    rainFallback?.start();
  };

  const initThemeScene = () => {
    syncScene();

    if (themeSceneBound) return;
    themeSceneBound = true;

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (target instanceof Element && target.closest('[data-theme-toggle]')) {
        window.requestAnimationFrame(syncScene);
      }
    });

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    motionQuery.addEventListener('change', syncScene);
  };

  initThemeScene();
  document.addEventListener('astro:page-load', initThemeScene);
</script>


