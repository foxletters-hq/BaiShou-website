---
import { getContributors, CONTRIBUTORS_URL, REPO_URL } from '../data/site';
import zhCN from '../i18n/locales/zh-CN';

const contributors = await getContributors();

function resolveBadge(login: string): string {
  const key = login.toLowerCase();
  if (key === 'anson-trio') return '🦊';
  if (key === 'ratman463' || key.startsWith('ratman')) return '🧀';
  if (key === 'ctnilpp' || key.startsWith('ctn')) return '🐦';
  if (key === 'magnemomet') return '😺';
  return '🌿';
}
---

<section id="people" class="snap-page snap-page-footer">
  <div class="container snap-page-inner">
    <div class="people-section people-section-wall reveal">
      <div class="section-heading">
        <p class="section-eyebrow" data-i18n="people.wallEyebrow">{zhCN.people.wallEyebrow}</p>
        <h2 data-i18n="people.wallTitle">{zhCN.people.wallTitle}</h2>
        <p class="section-lead">
          <span data-i18n="people.wallLeadBefore">{zhCN.people.wallLeadBefore}</span><a href={REPO_URL} target="_blank" rel="noopener noreferrer" data-i18n="people.wallLeadLink">{zhCN.people.wallLeadLink}</a><span data-i18n="people.wallLeadAfter">{zhCN.people.wallLeadAfter}</span>
        </p>
      </div>

      <div class="contributors-wall card reveal">
        <div class="contributors-grid" id="contributors-grid">
          {contributors.map((c) => {
            const isFounder = c.login.toLowerCase() === 'anson-trio';
            const badge = resolveBadge(c.login);
            return (
              <a
                href={c.html_url}
                target="_blank"
                rel="noopener noreferrer"
                class:list={['contributor-item', { 'contributor-item-founder': isFounder }]}
                title={`@${c.login}${isFounder ? ' · 创始人' : ''}${isFounder && c.contributions ? ` (${c.contributions} 次提交)` : ''}`}
                aria-label={`@${c.login}`}
                data-commits={c.contributions}
              >
                <div class="contributor-avatar-wrap">
                  <img
                    src={c.avatar_url}
                    alt={c.login}
                    class="contributor-avatar"
                    width="50"
                    height="50"
                    loading="lazy"
                  />
                  {badge && (
                    <span class="contributor-badge-founder" aria-hidden="true">{badge}</span>
                  )}
                </div>
                {isFounder && c.contributions > 0 && (
                  <span class="contributor-commits">
                    <span class="contributor-commits-num">{c.contributions.toLocaleString()}</span>
                    <span class="contributor-commits-unit" data-i18n="people.commitsUnit">
                      {zhCN.people.commitsUnit}
                    </span>
                  </span>
                )}
                <div class="contributor-info">
                  <span class="contributor-login">@{c.login}</span>
                  {isFounder && (
                    <span class="contributor-role-tag" data-i18n="people.founderRole">
                      {zhCN.people.founderRole}
                    </span>
                  )}
                </div>
              </a>
            );
          })}
        </div>
        <div class="contributors-wall-footer">
          <p class="contributors-badge-hint">
            <span data-i18n="people.badgeHintBefore">{zhCN.people.badgeHintBefore}</span><a
              href={`${REPO_URL}/issues`}
              target="_blank"
              rel="noopener noreferrer"
              data-i18n="people.badgeHintLink"
            >{zhCN.people.badgeHintLink}</a><span data-i18n="people.badgeHintAfter">{zhCN.people.badgeHintAfter}</span>
          </p>
          <a
            href={CONTRIBUTORS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="contributors-view-all"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
            <span data-i18n="people.collabLeadLink">{zhCN.people.collabLeadLink}</span>
            <span class="wall-arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const grid = document.getElementById('contributors-grid');
    if (!grid) return;

    const CACHE_TIME_KEY = 'baishou_contributors_time_v5';
    const CACHE_DATA_KEY = 'baishou_contributors_data_v5';
    const now = Date.now();
    const last = parseInt(sessionStorage.getItem(CACHE_TIME_KEY) || '0', 10);

    function getBadge(login: string): string {
      const k = login.toLowerCase();
      if (k === 'anson-trio') return '🦊';
      if (k === 'ratman463' || k.startsWith('ratman')) return '🧀';
      if (k === 'ctnilpp' || k.startsWith('ctn')) return '🐦';
      if (k === 'magnemomet') return '😺';
      return '🌿';
    }

    type LiveContributor = {
      login: string;
      avatar_url: string;
      html_url: string;
      contributions: number;
    };

    const MAX_DISPLAY = 20;

    function sortList(list: LiveContributor[]): LiveContributor[] {
      return [...list]
        .sort((a, b) => {
          const aFounder = a.login.toLowerCase() === 'anson-trio' ? 1 : 0;
          const bFounder = b.login.toLowerCase() === 'anson-trio' ? 1 : 0;
          if (aFounder !== bFounder) return bFounder - aFounder;
          if (b.contributions !== a.contributions) return b.contributions - a.contributions;
          return a.login.toLowerCase().localeCompare(b.login.toLowerCase());
        })
        .slice(0, MAX_DISPLAY);
    }

    function applyContributors(list: LiveContributor[]) {
      if (!grid || !Array.isArray(list) || list.length === 0) return;

      const existingMap = new Map<string, HTMLAnchorElement>();
      const mergedMap = new Map<string, LiveContributor>();

      grid.querySelectorAll<HTMLAnchorElement>('.contributor-item').forEach((el) => {
        const rawLogin = el.getAttribute('aria-label')?.replace(/^@/, '') || '';
        const key = rawLogin.toLowerCase();
        if (!key) return;
        existingMap.set(key, el);
        const numText = el.querySelector('.contributor-commits-num')?.textContent;
        const commits =
          parseInt((numText || el.dataset.commits || '1').replace(/,/g, ''), 10) || 1;
        const imgEl = el.querySelector<HTMLImageElement>('.contributor-avatar');
        mergedMap.set(key, {
          login: rawLogin,
          avatar_url: imgEl?.src || `https://github.com/${rawLogin}.png`,
          html_url: el.href || `https://github.com/${rawLogin}`,
          contributions: commits,
        });
      });

      for (const item of list) {
        if (!item?.login) continue;
        mergedMap.set(item.login.toLowerCase(), {
          login: item.login,
          avatar_url: item.avatar_url || `https://github.com/${item.login}.png`,
          html_url: item.html_url || `https://github.com/${item.login}`,
          contributions: Number(item.contributions) || 1,
        });
      }

      const unitEl = grid.querySelector('[data-i18n="people.commitsUnit"]');
      const unitText = unitEl?.textContent || '次提交';
      const roleEl = grid.querySelector('[data-i18n="people.founderRole"]');
      const roleText = roleEl?.textContent || '创始人';

      const sorted = sortList(Array.from(mergedMap.values()));
      const keptKeys = new Set(sorted.map((item) => item.login.toLowerCase()));
      existingMap.forEach((el, key) => {
        if (!keptKeys.has(key)) el.remove();
      });

      for (const item of sorted) {
        const key = item.login.toLowerCase();
        const commits = Number(item.contributions) || 1;
        const isFounder = key === 'anson-trio';
        const existing = existingMap.get(key);

        if (existing) {
          existing.dataset.commits = String(commits);
          const numEl = existing.querySelector('.contributor-commits-num');
          if (numEl) numEl.textContent = commits.toLocaleString();
          existing.title = isFounder
            ? `@${item.login} · 创始人 (${commits} 次提交)`
            : `@${item.login}`;
          const imgEl = existing.querySelector<HTMLImageElement>('.contributor-avatar');
          if (imgEl && item.avatar_url) imgEl.src = item.avatar_url;
          grid.appendChild(existing);
        } else {
          const badge = getBadge(item.login);
          const a = document.createElement('a');
          a.href = item.html_url || `https://github.com/${item.login}`;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.className = isFounder
            ? 'contributor-item contributor-item-founder'
            : 'contributor-item';
          a.dataset.commits = String(commits);
          a.title = isFounder
            ? `@${item.login} · 创始人 (${commits} 次提交)`
            : `@${item.login}`;
          a.setAttribute('aria-label', `@${item.login}`);
          a.innerHTML = `
            <div class="contributor-avatar-wrap">
              <img src="${item.avatar_url}" alt="${item.login}" class="contributor-avatar" width="50" height="50" loading="lazy" />
              <span class="contributor-badge-founder" aria-hidden="true">${badge}</span>
            </div>
            ${
              isFounder
                ? `<span class="contributor-commits">
              <span class="contributor-commits-num">${commits.toLocaleString()}</span>
              <span class="contributor-commits-unit" data-i18n="people.commitsUnit">${unitText}</span>
            </span>`
                : ''
            }
            <div class="contributor-info">
              <span class="contributor-login">@${item.login}</span>
              ${isFounder ? `<span class="contributor-role-tag" data-i18n="people.founderRole">${roleText}</span>` : ''}
            </div>
          `;
          grid.appendChild(a);
        }
      }
    }

    const cachedRaw = sessionStorage.getItem(CACHE_DATA_KEY);
    if (now - last < 5 * 60 * 1000 && cachedRaw) {
      try {
        applyContributors(JSON.parse(cachedRaw));
        return;
      } catch {
        /* ignore cache parse error */
      }
    }

    const repos = [
      'https://api.github.com/repos/foxletters-hq/BaiShou-Next/contributors?per_page=100',
      'https://api.github.com/repos/foxletters-hq/BaiShou-website/contributors?per_page=100',
    ];

    Promise.allSettled(
      repos.map((url) =>
        fetch(url, { headers: { Accept: 'application/vnd.github.v3+json' } }).then((res) =>
          res.ok ? res.json() : []
        )
      )
    )
      .then((results) => {
        const map = new Map<string, LiveContributor>();
        for (const res of results) {
          if (res.status !== 'fulfilled' || !Array.isArray(res.value)) continue;
          for (const item of res.value) {
            if (
              !item?.login ||
              item.login.endsWith('[bot]') ||
              item.type === 'Bot' ||
              item.login.toLowerCase() === 'alice'
            )
              continue;
            const key = item.login.toLowerCase();
            const prev = map.get(key);
            if (prev) {
              prev.contributions += Number(item.contributions) || 0;
            } else {
              map.set(key, {
                login: item.login,
                avatar_url: item.avatar_url || `https://github.com/${item.login}.png`,
                html_url: item.html_url || `https://github.com/${item.login}`,
                contributions: Number(item.contributions) || 1,
              });
            }
          }
        }
        const merged = sortList(Array.from(map.values()));
        if (merged.length > 0) {
          sessionStorage.setItem(CACHE_TIME_KEY, String(now));
          sessionStorage.setItem(CACHE_DATA_KEY, JSON.stringify(merged));
          applyContributors(merged);
        }
      })
      .catch(() => {});
  })();
</script>

