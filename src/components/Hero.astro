---
import BilibiliIcon from './BilibiliIcon.astro';
import GithubIcon from './GithubIcon.astro';
import QqIcon from './QqIcon.astro';
import { BILIBILI_URL, REPO_URL } from '../data/site';
---

<section id="hero" class="snap-page hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-eyebrow animate-in" data-i18n="hero.eyebrow">BaiShou</p>
      <h1 class="hero-title animate-in animate-in-delay-1" data-i18n="hero.title">白守</h1>
      <p class="hero-tagline animate-in animate-in-delay-2" data-i18n="hero.tagline">
        以纯白誓约，守护彼此一生
      </p>
      <p class="hero-positioning animate-in animate-in-delay-2" data-i18n="hero.positioning">
        本地优先、向量数据库与图数据库驱动的 AI 长期记忆与智能体系统。
      </p>
      <p class="hero-desc animate-in animate-in-delay-3" data-i18n="hero.desc">
        深度融合日常日记、向量语义记忆、图数据库人生关系图谱与自主 Agent 智能体。数据默认 100% 留存本地，支持 MCP 开放协议与多端加密同步。
      </p>
      <div class="hero-actions animate-in animate-in-delay-4">
        <button
          type="button"
          class="btn btn-outline"
          data-community-open
        >
          <QqIcon size={18} />
          <span data-i18n="hero.ctaCommunity">加入社群</span>
        </button>
        <a
          href={BILIBILI_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline btn-bilibili"
        >
          <BilibiliIcon size={18} />
          <span data-i18n="hero.ctaBilibili">哔哩哔哩</span>
        </a>
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          <GithubIcon size={18} />
          <span data-i18n="hero.ctaGithub">前往 GitHub</span>
        </a>
      </div>
    </div>

    <div class="hero-visual animate-in animate-in-delay-2">
      <div class="app-icon-frame" aria-hidden="true">
        <img
          src="/assets/images/app-icon.png"
          alt="白守应用图标"
          class="app-icon-hero"
          data-i18n-alt="hero.iconAlt"
          width="420"
          height="420"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
