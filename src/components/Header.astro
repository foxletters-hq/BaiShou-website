---
import { SNAP_SECTION_IDS, navHref } from "../data/site";
import { t } from "../i18n";
import zhCN from "../i18n/locales/zh-CN";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

export interface Props {
  snapDots?: boolean;
}

const { snapDots = true } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isDocs = /(^|\/)docs(\/|$)/.test(path);
const isHome = path === "/";

let pageLocale = "zh-CN";
if (/^\/en(\/|$)/.test(path)) pageLocale = "en";
else if (/^\/ja(\/|$)/.test(path)) pageLocale = "ja";
else if (/^\/zh-tw(\/|$)/.test(path)) pageLocale = "zh-TW";

const docsHref =
  pageLocale === "en"
    ? "/en/docs/"
    : pageLocale === "ja"
      ? "/ja/docs/"
      : pageLocale === "zh-TW"
        ? "/zh-tw/docs/"
        : "/docs/";
---

<header class="site-header" transition:persist={isDocs ? "site-header" : undefined}>
  <div class="container site-header-shell">
    <div class="header-inner">
      <a href="/" class="brand">
        <img
          src="/assets/images/app-icon.png"
          alt=""
          width="36"
          height="36"
          class="brand-icon"
        />
        <span class="brand-text">
          <span data-i18n="brand.name">白守</span><span
            class="brand-suffix"
            data-i18n="brand.suffix"
          >
            · 狐信科技</span
          >
        </span>
      </a>

      <nav
        class="header-nav"
        aria-label="页面导航"
        data-i18n-aria-label="a11y.mainNav"
      >
        <a
          href="/"
          class:list={[{ "is-active": isHome }]}
          data-i18n="nav.home"
          aria-current={isHome ? "page" : undefined}
        >
          官网
        </a>
        <a
          href={docsHref}
          class:list={[{ "is-active": isDocs }]}
          data-i18n="nav.docsAction"
          data-docs-link
          aria-current={isDocs ? "page" : undefined}
        >
          文档
        </a>
      </nav>

      <div class="header-actions">
        <button
          type="button"
          class="btn btn-primary header-dl-btn"
          data-dl-open
          aria-label="下载"
          data-i18n-aria-label="download.button"
        >
          <svg
            class="header-dl-icon"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 4v11" />
            <path d="m7 11 5 5 5-5" />
            <path d="M5 20h14" />
          </svg>
          <span class="header-dl-text" data-i18n="download.button">下载</span>
        </button>
        <ThemeToggle />
        <LanguageSwitcher />
      </div>
    </div>
  </div>
</header>

{
  snapDots && (
    <nav
      class="snap-dots"
      aria-label="页面分屏导航"
      data-i18n-aria-label="a11y.snapNav"
      data-snap-rail
    >
      <div class="snap-steps">
        <div class="snap-progress-track" aria-hidden="true">
          <div class="snap-progress-fill" data-snap-progress-fill />
        </div>
        {SNAP_SECTION_IDS.map((id, idx) => {
          const labelKey = id === "hero" ? "brand.name" : `nav.${id}`;
          const label = t(zhCN, labelKey);
          const stepNum = `0${idx + 1}`;
          return (
            <a
              href={navHref(id)}
              class:list={["snap-dot", { "is-active": idx === 0 }]}
              data-snap-dot={id}
              data-snap-index={idx}
              data-i18n-aria-label={labelKey}
              aria-label={label}
            >
              <span class="snap-dot-node" aria-hidden="true" />
              <span class="snap-dot-index" aria-hidden="true">{stepNum}</span>
              <span class="snap-dot-label" data-i18n={labelKey}>
                {label}
              </span>
            </a>
          );
        })}
      </div>
    </nav>
  )
}
