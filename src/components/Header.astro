---
import { SNAP_SECTION_IDS, navHref } from "../data/site";
import { t } from "../i18n";
import zhCN from "../i18n/locales/zh-CN";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

export interface Props {
  snapDots?: boolean;
}

const { snapDots = true } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isDocs = /(^|\/)docs(\/|$)/.test(path);
const isHome = path === "/";
---

<header class="site-header" transition:persist={isDocs ? "site-header" : undefined}>
  <div class="container site-header-shell">
    <div class="header-inner">
      <a href="/" class="brand">
        <img
          src="/assets/images/app-icon.png"
          alt=""
          width="36"
          height="36"
          class="brand-icon"
        />
        <span class="brand-text">
          <span data-i18n="brand.name">白守</span><span
            class="brand-suffix"
            data-i18n="brand.suffix"
          >
            · Foxletters</span
          >
        </span>
      </a>

      <nav
        class="header-nav"
        aria-label="页面导航"
        data-i18n-aria-label="a11y.mainNav"
      >
        <a
          href="/"
          class:list={[{ "is-active": isHome }]}
          data-i18n="nav.home"
          aria-current={isHome ? "page" : undefined}
        >
          官网
        </a>
        <a
          href="/docs/"
          class:list={[{ "is-active": isDocs }]}
          data-i18n="nav.docsAction"
          data-docs-link
          aria-current={isDocs ? "page" : undefined}
        >
          文档
        </a>
      </nav>

      <div class="header-actions">
        <button type="button" class="btn btn-primary header-dl-btn" data-dl-open data-i18n="download.button">
          下载
        </button>
        <ThemeToggle />
        <LanguageSwitcher />
      </div>
    </div>
  </div>
</header>

{
  snapDots && (
    <nav
      class="snap-dots"
      aria-label="页面分屏导航"
      data-i18n-aria-label="a11y.snapNav"
    >
      {SNAP_SECTION_IDS.map((id) => {
        const labelKey = id === "hero" ? "brand.name" : `nav.${id}`;
        const label = t(zhCN, labelKey);
        return (
          <a
            href={navHref(id)}
            class="snap-dot"
            data-snap-dot={id}
            data-i18n-aria-label={labelKey}
            aria-label={label}
          >
            <span class="snap-dot-label" data-i18n={labelKey}>
              {label}
            </span>
          </a>
        );
      })}
    </nav>
  )
}
