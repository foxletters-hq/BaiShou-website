---
import BilibiliIcon from './BilibiliIcon.astro';
import GithubIcon from './GithubIcon.astro';
import QqIcon from './QqIcon.astro';
import { BILIBILI_URL, ICP_FILING_NUMBER, ICP_FILING_URL, REPO_URL } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-meta">
      <p class="footer-copy">© 2026 foxletters-hq</p>
      <a
        class="footer-beian"
        href={ICP_FILING_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        {ICP_FILING_NUMBER}
      </a>
    </div>

    <div class="footer-actions">
      <button
        type="button"
        class="btn btn-outline footer-cta"
        data-community-open
      >
        <QqIcon size={18} />
        <span data-i18n="footer.joinCommunity">加入社群</span>
      </button>

      <a
        href={BILIBILI_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link footer-link-bilibili"
      >
        <BilibiliIcon size={18} />
        <span data-i18n="footer.bilibili">哔哩哔哩</span>
      </a>

      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link footer-link-github"
      >
        <GithubIcon size={18} />
        <span data-i18n="footer.github">GitHub</span>
      </a>
    </div>
  </div>
</footer>
