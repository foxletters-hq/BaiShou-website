server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root __DIST_DIR__;
    index index.html;

    # Astro 静态导出：优先精确文件，其次目录，再次同名 .html
    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    error_page 404 /404.html;
}
